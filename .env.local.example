# ============================================================================
# GIOVANNA: SOVEREIGN HEALING COSMOLOGY
# Environment Configuration Template
# ============================================================================

# ZERO-KNOWLEDGE PRINCIPLE:
# - All family data stays encrypted at rest
# - No user PII should ever reach external AI APIs
# - All values below must be configured in Vercel Dashboard as Secrets

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================

# Firebase Web API Key (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Authentication Domain
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Firebase App ID
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ============================================================================
# AI/ORACLE CONFIGURATION (Optional - for external AI features)
# ============================================================================

# OpenAI API Key (if using GPT for narrative refraction)
# WARNING: Enable Consciousness Guardrails before use
VITE_ORACLE_API_KEY=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Village sharing features
VITE_ENABLE_VILLAGE=true

# Enable Mission Room B2B dashboard
VITE_ENABLE_MISSION_ROOM=true

# Enable Voice Capture (requires microphone permission)
VITE_ENABLE_VOCAL_LEDGER=true

# ============================================================================
# SECURITY NOTES
# ============================================================================

# 1. NEVER commit this file with real values to version control
# 2. Use Vercel's encrypted Environment Variables for production
# 3. All Firebase keys should have domain restrictions enabled
# 4. The ORACLE_API_KEY should have rate limits configured
# 5. Run 'anonymize before transmit' guardrails are MANDATORY
